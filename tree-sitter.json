{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "mirth",
      "camelcase": "Mirth",
      "title": "Mirth",
      "scope": "source.mirth",
      "file-types": [
        "mth"
      ],
      "injection-regex": "^mirth$",
      "class-name": "TreeSitterMirth"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Mirth is a strongly-typed concatenative programming language",
    "authors": [
      {
        "name": "amatgil",
        "email": "amatgilvinyes@gmail.com",
        "url": "amatgil.cat"
      }
    ],
    "links": {
      "repository": "https://codeberg.org/typeswitch/mirth",
      "funding": "https://www.patreon.com/typeswitch"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}